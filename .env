# ─── Site Configuration ───────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME="The Travel Place"
NEXT_PUBLIC_SITE_URL="https://ttp.ng"
NEXT_PUBLIC_SITE_DESCRIPTION="Your one-stop travel booking platform for flights, hotels, car rentals, and visa assistance"

# ─── API Configuration ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL="https://api.ttp.ng/api/v1"
NEXT_PUBLIC_API_TIMEOUT=30000

# ─── Authentication ───────────────────────────────────────────────────────────
NEXT_PUBLIC_AUTH_COOKIE_NAME="ttp_auth_token"
NEXT_PUBLIC_REFRESH_TOKEN_NAME="ttp_refresh_token"

# ─── Google OAuth ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID="341545303899-rd7pbr9eqrduu62j5h4ufto0ee522vj6.apps.googleusercontent.com"

# ─── Paystack ─────────────────────────────────────────────────────────────────
# Production uses live keys — set NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY in Vercel dashboard
# Do NOT commit live keys here
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_live_REPLACE_IN_VERCEL_DASHBOARD"

# ─── Feature Flags ────────────────────────────────────────────────────────────
NEXT_PUBLIC_DEBUG_MODE=false
NEXT_PUBLIC_ENABLE_GUEST_CHECKOUT=true
NEXT_PUBLIC_ENVIRONMENT="production"
